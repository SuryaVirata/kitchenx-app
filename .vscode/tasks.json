{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KitchenX: customer web dev",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "customer:web"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": false,
        "reveal": "always"
      }
    },
    {
      "label": "KitchenX: customer web dev clear cache",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "customer:web:clear"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": false,
        "reveal": "always"
      }
    }
  ]
}
