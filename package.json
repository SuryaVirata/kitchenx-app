{
  "name": "kitchenx-app",
  "private": true,
  "version": "1.0.0",
  "description": "KitchenX customer mobile app (iOS, Android, Web) with shared packages.",
  "scripts": {
    "customer": "pnpm --filter @kitchenx/customer start",
    "customer:web": "pnpm --filter @kitchenx/customer web",
    "customer:web:clear": "pnpm --filter @kitchenx/customer web:clear",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.6"
}
